{
  "alakazamTemplate": true,
  "version": 2,
  "name": "MMN (Luck ch 7)",
  "nodes": [
    {
      "transformId": "DefineBins",
      "parent": -1,
      "params": {
        "script": "% From the chapter's own BDF_MMN.txt. Codes verified in the recording:\n% 70 = deviant (200 events), 80 = standard (785).\nbin 1 \"Deviant\"                    : 70\nbin 2 \"Standard preceded by one\"   : 80 and prev(80)\n\n% The MMN: deviant minus standard.\nbin 3 \"MMN\" = bin 1 - bin 2",
        "epoch": {
          "lo": -200,
          "hi": 800,
          "unit": "ms"
        }
      }
    },
    {
      "transformId": "Baseline",
      "parent": 1,
      "params": {
        "Start": -200,
        "Stop": 0
      }
    },
    {
