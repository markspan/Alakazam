          "Absolute threshold"
        ],
        "Minimum": -100,
        "Maximum": 100,
        "Threshold": 100,
        "Window": 200,
        "Step": 100,
        "TestStart": -200,
        "TestStop": 795,
        "Channels": "All channels",
        "Scope": "Whole epoch"
      }
    },
    {
      "transformId": "Average",
      "parent": 3,
      "params": {
        "Param": "Init"
      }
    },
    {
