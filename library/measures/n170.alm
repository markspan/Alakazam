{
  "alakazamMeasures": true,
  "version": 1,
  "description": {
    "morphology": "Negative deflection peaking around 130 to 200 ms over lateral occipitotemporal sites (P7/P8, PO7/PO8; measured here at PO8), typically larger over the right hemisphere.",
    "meaning": "Reflects the structural encoding of faces and other categories of visual expertise. It is enlarged and delayed for inverted relative to upright faces (the face inversion effect).",
    "task": "Face perception paradigms: faces versus objects, upright versus inverted faces, and viewing of facial identity or expression."
  },
  "source": {
    "reference": "Kappenman, E. S., Farrens, J. L., Zhang, W., Stewart, A. X., & Luck, S. J. (2021). ERP CORE: An open resource for human event-related potential research. NeuroImage, 225, 117465.",
    "doi": "https://doi.org/10.1016/j.neuroimage.2020.117465",
    "agreement": "not compared",
    "note": "ERP CORE gives an a priori window and site for the N170 (faces minus cars, average reference). This preset has not yet been compared with them."
  },
  "rows": [
    {
      "label": "N170",
      "start": 130,
      "stop": 200,
      "measure": "Peak",
      "polarity": "Negative",
      "width": 100,
      "localPoints": 2,
      "fraction": 0.5,
      "refChannel": "",
      "channels": "PO8"
    }
  ]
}
