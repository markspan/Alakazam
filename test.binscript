% epoch_start_ms: -200
% epoch_stop_ms: 800
% Codes are markers; ? = any char; { } lists alternatives; | is or.
% Relations: next(c) prev(c) adjacent(c) any(c) within (lo,hi] ms/samples/events.
% let names a reusable expression (codes or relations); = makes a difference bin.

let All = 28
let at400 = 40
let at400fix = 60
let at1000 = 100

bin 1 "all at once" All
bin 2 "400 ms each, one after another" at400
bin 3 "with a 600 ms fixation cross" at400fix
bin 4 "1000 ms each, one after another" at1000
