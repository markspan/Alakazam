    {
      "label": "LPP",
      "start": 400,
      "stop": 800,
      "measure": "Mean Amplitude",
      "polarity": "Positive",
      "width": 100,
      "localPoints": 0,
      "fraction": 0.5,
      "refChannel": "",
      "channels": "Pz"
    }
  ]
