    {
      "label": "P300",
      "start": 300,
      "stop": 600,
      "measure": "Mean Amplitude",
      "polarity": "Positive",
      "width": 100,
      "localPoints": 0,
      "fraction": 0.5,
      "refChannel": "",
      "channels": "Pz"
    }
  ]
}
